{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PULSEFRAME",
  "version": "1.36.0",
  "identifier": "com.pulseframe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PULSEFRAME",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#090B0F",
        "theme": "Dark",
        "label": "main",
        "visible": false,
        "center": true,
        "maximized": true
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "width": 960,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "backgroundColor": "#05070a",
        "focus": false,
        "title": "PULSEFRAME"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**",
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pulseframe"
        ],
        "name": "PULSEFRAME.Project",
        "description": "PULSEFRAME music video project",
        "role": "Editor",
        "mimeType": "application/x-pulseframe"
      },
      {
        "ext": [
          "pulse"
        ],
        "name": "PULSEFRAME.Package",
        "description": "PULSEFRAME project in one file",
        "role": "Editor",
        "mimeType": "application/x-pulseframe-package"
      },
      {
        "ext": [
          "pfproducer"
        ],
        "name": "PULSEFRAME.Producer",
        "description": "PULSEFRAME Producer package",
        "role": "Viewer",
        "mimeType": "application/x-pulseframe-producer"
      }
    ],
    "resources": {
      "icons/document.ico": "document.ico",
      "../analysis/pulseframe_analysis/*.py": "engine/pulseframe_analysis/",
      "../analysis/pulseframe_analysis/styles.json": "engine/pulseframe_analysis/styles.json",
      "../analysis/requirements-engine.txt": "engine/requirements-engine.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sign.ps1 -File %1"
    },
    "shortDescription": "Direct music into motion.",
    "publisher": "PULSEFRAME",
    "copyright": "Copyright (c) 2026 PULSEFRAME. All rights reserved.",
    "longDescription": "PULSEFRAME turns a song into a directed music video: it listens, plans every shot on the beat, renders with the AI models you choose (or free on your own ComfyUI), and exports the finished video.",
    "licenseFile": "../LICENSE.txt"
  }
}
