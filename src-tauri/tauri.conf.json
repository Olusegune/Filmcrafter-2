{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FilmCrafter",
  "version": "0.29.0",
  "identifier": "com.filmcrafter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FilmCrafter",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 660,
        "backgroundColor": "#090B0F",
        "theme": "Dark",
        "label": "main",
        "visible": false,
        "center": true,
        "maximized": true
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "width": 960,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "backgroundColor": "#05070a",
        "focus": false,
        "title": "FilmCrafter"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/FilmCrafter/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "filmcrafter"
        ],
        "name": "FilmCrafter.Project",
        "description": "FilmCrafter film",
        "role": "Editor",
        "mimeType": "application/x-filmcrafter"
      },
      {
        "ext": [
          "filmpack"
        ],
        "name": "FilmCrafter.Package",
        "description": "FilmCrafter film in one file",
        "role": "Editor",
        "mimeType": "application/x-filmcrafter-package"
      }
    ],
    "resources": {
      "icons/document.ico": "document.ico",
      "../analysis/filmcrafter_engine/*.py": "engine/filmcrafter_engine/",
      "../analysis/filmcrafter_engine/styles.json": "engine/filmcrafter_engine/styles.json",
      "../analysis/requirements-engine.txt": "engine/requirements-engine.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sign.ps1 -File %1"
    },
    "shortDescription": "Craft stories into cinema.",
    "publisher": "FilmCrafter",
    "copyright": "Copyright (c) 2026 FilmCrafter. All rights reserved.",
    "longDescription": "FilmCrafter turns a story into a film: it reads your screenplay, builds the cast and world, plans every shot, makes the pictures and video with the AI models you choose (or free on your own ComfyUI), lip-syncs your own recorded voices, and exports the finished film or a hand-off to your editor.",
    "licenseFile": "../LICENSE.txt"
  }
}
